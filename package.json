{
  "name": "@b4fun/smol-dashboard",
  "version": "0.1.0",
  "description": "Minimal dashboard component library and shadcn registry.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "public/r",
    "registry.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:registry",
    "build:lib": "tsup && node --input-type=module -e \"import { copyFileSync } from 'node:fs'; copyFileSync('src/styles.css', 'dist/styles.css')\"",
    "build:registry": "shadcn build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run typecheck && npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:a11y": "playwright test"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
