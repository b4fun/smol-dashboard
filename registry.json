{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "@b4fun/smol-dashboard",
  "homepage": "https://github.com/b4fun/smol-dashboard",
  "items": [
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "A minimal dashboard button with variants and sizes.",
      "dependencies": [
        "class-variance-authority"
      ],
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "src/components/ui/button.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "context-menu",
      "type": "registry:ui",
      "title": "Context Menu",
      "description": "Accessible right-click and keyboard context menu with actions, checkboxes, radio items, and submenus.",
      "dependencies": [
        "@radix-ui/react-context-menu@2.2.16",
        "@radix-ui/react-slot@1.2.3",
        "@radix-ui/react-compose-refs@1.1.2"
      ],
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "src/components/ui/context-menu.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/menu-accessibility.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/menu-styles.ts",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "dropdown-menu",
      "type": "registry:ui",
      "title": "Dropdown Menu",
      "description": "Button-triggered menu with keyboard navigation, selectable items, and submenus.",
      "dependencies": [
        "@radix-ui/react-dropdown-menu@2.1.16",
        "@radix-ui/react-slot@1.2.3",
        "@radix-ui/react-compose-refs@1.1.2"
      ],
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "src/components/ui/dropdown-menu.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/menu-accessibility.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/ui/menu-styles.ts",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "app-shell",
      "type": "registry:component",
      "title": "App Shell",
      "description": "Responsive dashboard shell with grouped navigation, an inset content panel, and a collapsible sidebar.",
      "dependencies": [
        "class-variance-authority"
      ],
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "src/components/app-shell.tsx",
          "type": "registry:component"
        },
        {
          "path": "src/components/ui/button.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/components/app-shell-header.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "status-indicator",
      "type": "registry:ui",
      "title": "Status Indicator",
      "description": "Hollow status ring with success, failed, warning, and neutral states and an accessible name.",
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "src/components/ui/status-indicator.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "collapsible-list",
      "type": "registry:component",
      "title": "Collapsible List",
      "description": "Grouped disclosure list with item counts, decorative icons, details, and trailing metadata.",
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "src/components/collapsible-list.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "app-shell-header",
      "type": "registry:component",
      "title": "App Shell Header",
      "description": "Dashboard header with ancestor breadcrumbs, current page heading, and action slots.",
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "src/components/app-shell-header.tsx",
          "type": "registry:component"
        }
      ]
    }
  ]
}
